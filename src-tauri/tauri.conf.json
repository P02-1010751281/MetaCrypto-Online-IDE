{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "MetaCrypto Online IDE",
  "mainBinaryName": "metacrypto-online-ide",
  "identifier": "com.ciphercat.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MetaCrypto Online IDE",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; base-uri 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "shortDescription": "Post-quantum cryptography visual programming platform",
    "longDescription": "A visual cryptography programming platform based on Blockly and Vue 3. Workspaces are assembled from reusable atomic blocks, JavaScript and Python code is generated from them, and the generated code runs in a browser sandbox.",
    "linux": {
      "deb": {
        "desktopTemplate": "desktop/metacrypto-online-ide.desktop",
        "conflicts": ["cipher-cat"],
        "replaces": ["cipher-cat"],
        "provides": ["cipher-cat"],
        "files": {
          "/usr/share/doc/cipher-cat/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "desktopTemplate": "desktop/metacrypto-online-ide.desktop"
      }
    }
  }
}

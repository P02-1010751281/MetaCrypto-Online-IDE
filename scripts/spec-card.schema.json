{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ciphercat/spec-card/v0",
  "title": "CipherCat SpecCard v0",
  "description": "把一个标准/参考条目的原文锚点、接口与块映射固化成机器可校验的规格卡。卡片只写事实与来源，不写机器可复核的结论（哈希、引文匹配由 scripts/check-spec-cards.mjs 重算）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "standard", "anchors", "entries", "provenance"],
  "properties": {
    "schema": { "const": "ciphercat.spec-card/v0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "enum": ["standard", "reference", "paper"] },
    "standard": { "$ref": "#/$defs/standard" },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/anchor" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "limits": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "本卡明确不覆盖的内容。缺省视为不影响结论，但建议每张卡都写。"
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "规格歧义或缺项。写进这里，不要靠猜测补全。"
    }
  },
  "$defs": {
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_url", "dir", "artifacts"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "pattern": "^https://" },
        "dir": {
          "type": "string",
          "description": "相对卡片文件所在目录的标准目录；通常为 '.' 表示卡片就放在标准目录里。"
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "line_range",
        "quote",
        "quote_sha256",
        "anchor_grade",
        "extractor"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "相对卡片文件所在目录的文本层文件（提取稿），不能是 PDF 二进制。"
        },
        "line_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1 }
        },
        "quote": { "type": "string", "minLength": 1 },
        "quote_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "对 quote 规范化空白（\\s+ → 单空格、去首尾）后取 SHA-256。"
        },
        "anchor_grade": {
          "enum": ["A", "B", "C"],
          "description": "A=行级引文可复核且 PDF 物理页已人工核对；B=行级引文可复核但 PDF 页未核；C=仅章节级定位。"
        },
        "pdf_pages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "PDF 物理页（从 1 起）。anchor_grade=A 时必填。"
        },
        "extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "args": { "type": "string" }
          }
        },
        "known_defects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "文本层已知失真（上标丢失、ceiling 括号丢失等）。有失真时不得让下游把它当逐字规范。"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "io", "pseudocode"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "description": "稳定标识，用于跨卡引用；不要随文档改版重命名。"
        },
        "type": {
          "enum": ["原语", "函数", "组合", "模式", "协议", "数据"],
          "description": "规范单元类型，与 docs/standards 的条目元数据口径一致。"
        },
        "io": { "$ref": "#/$defs/io" },
        "params": {
          "type": "object",
          "description": "参数取值；值只能是 JSON 标量或字符串，不要放「待定」。"
        },
        "normative_level": { "enum": ["MUST", "SHOULD", "MAY", "n/a"] },
        "pseudocode": { "$ref": "#/$defs/pseudocode" },
        "blocks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existing": {
              "type": "array",
              "items": { "type": "string" },
              "description": "必须存在于 docs/blocks/BLOCK-IO-CONTRACT.json 的块类型。"
            },
            "planned": { "type": "array", "items": { "type": "string" } }
          }
        },
        "vectors": { "$ref": "#/$defs/vectors" }
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/port" } }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "description": "取 BLOCK-IO-CONTRACT.json 实际出现的 check 标签（Bytes/IntList/Number/String/Bits/Boolean/SBox），或 Any。"
        },
        "length": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "pseudocode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fidelity", "text"],
      "properties": {
        "fidelity": {
          "enum": ["verbatim", "text-layer", "paraphrase"],
          "description": "verbatim=与锚点引文逐字一致；text-layer=与文本层一致但文本层本身有已知失真；paraphrase=项目改写，只能作导航。"
        },
        "anchor": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "known_defects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "fidelity=text-layer 时必填。"
        }
      }
    },
    "vectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["wired", "partial", "missing", "n/a"] },
        "detail": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extracted_by", "review"],
      "properties": {
        "extracted_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["human", "llm", "tool"] },
            "name": { "type": "string" },
            "model": { "type": "string", "description": "kind=llm 时必填。" },
            "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["draft", "reviewed"] },
            "by": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "at"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
              }
            },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}

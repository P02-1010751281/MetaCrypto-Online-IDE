{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ciphercat.block-ir/v0",
  "title": "CipherCat 扁平积木 IR v0",
  "description": "只描述「块类型 + 字段 + 子槽」的语义结构；id、坐标与序列化细节由组装器补齐。inputs 的取值是嵌套节点，其形状由 validateIr 递归校验（本仓库的极简 schema 校验器只实现 additionalProperties=false，不做 map-of-schema）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entry"
  ],
  "properties": {
    "schema": {
      "const": "ciphercat.block-ir/v0"
    },
    "source": {
      "type": "string",
      "description": "可选：IR 来自哪份 workspace（仅记账，不参与比较）。"
    },
    "entry": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "fields": {
          "type": "object"
        },
        "extraState": {
          "type": "object"
        },
        "inline": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        },
        "inputs": {
          "type": "object"
        },
        "next": {
          "$ref": "#/$defs/node"
        }
      }
    }
  }
}

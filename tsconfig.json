{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@cc/blocks": ["./src/blocks"],
      "@cc/blocks/*": ["./src/blocks/*"],
      "@cc/generators": ["./src/generators"],
      "@cc/generators/*": ["./src/generators/*"],
      "@cc/constants": ["./src/constants"],
      "@cc/constants/*": ["./src/constants/*"],
      "@cc/migration": ["./src/utils/migration"],
      "@cc/migration/*": ["./src/utils/migration/*"],
      "@cc/locale": ["./src/composables/locale"],
      "@cc/locale/*": ["./src/composables/locale/*"],
      "@cc/runtime": ["./src/runtime"],
      "@cc/runtime/*": ["./src/runtime/*"],
      "@cc/utils": ["./src/utils"],
      "@cc/utils/*": ["./src/utils/*"],
    },
    "forceConsistentCasingInFileNames": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts",
  ],
  "exclude": ["node_modules", "dist"],
}

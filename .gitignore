# Paper drafts (local only, publish when ready). The downloaded research bundle
# is intentionally versioned so the research report remains reproducible.
paper/*
!paper/references/
!paper/references/*.pdf
!paper/references/README.md

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-ssr/
dist-verify/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.qoder/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Environment files
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
.cache/

# Test fixtures (workspace JSON, local only)
test/

# Tauri
src-tauri/target/
.cargo/

# Reasonix
.reasonix/
reasonix.toml
session-*.md

# 讨论日志与会话导出（本地维护，不入库 — 2026-08-03 决策）
discussion_log.md
DiscussionLog/

# 本地工具状态与临时下载（不入库）
.agents/
tmp/
nohup.out

# 本地备份归档（.bak 目录只存改前快照，不入库）
.bak/

# 规格卡生产者候选（spec:scaffold 生成的本地产物，不合并、不入库）
spec-runs/candidates/

# 实验产物的派生文件：由 load-check.mjs 从已入库的 output.json 确定性重生成，不入库
experiments/**/runs/*/assembled.workspace.json

# Pyodide 运行时（13MB，由 scripts/copy-pyodide.mjs 从 devDependency 重建）
public/pyodide/

# 本地验证脚本与门禁日志（临时产物，可随时重跑，不入库）
.review/

# Python 字节码缓存（scripts/tools 下的本地脚本会生成，不入库）
__pycache__/
*.pyc

# 一次性浏览器复核（c2w-combo-fixed-e2e.mjs）的临时 profile
experiments/ai-helper-2026-11-14/cdp-profile-*/
.shot/
